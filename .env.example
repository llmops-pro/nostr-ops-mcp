# Copy to .env and fill in your values. .env is gitignored.
# Env vars passed by the parent process (Claude Code, etc.) take precedence.

# Signer — provide AT MOST ONE. If neither is set the server runs in forced
# read-only mode (only the query/decode tools register).
#
# Strongly preferred: NOSTR_NIP46_URI. Keeps the nsec on your phone / Amber /
# nsec.app / Alby Account bunker; the agent never sees the raw key.

# NOSTR_NIP46_URI=bunker://<pubkey>?relay=wss://relay.example.com&secret=...

# Legacy / dev only: raw nsec on disk. Server logs a warning at startup if set.
# NOSTR_PRIVATE_KEY=nsec1...

# Relays. Required. Comma-separated list of wss:// URLs.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# Safety — REQUIRED when a signer is configured. Comma-separated event-kind
# numbers the server is allowed to sign. Keep tight — default omits kind 0
# (profile) and kind 5 (delete); both are easy to misuse.
#
# Useful starting set: 1 (text note), 4 (legacy DM), 30017 (NIP-15 stall), 30018 (NIP-15 product)
NOSTR_ALLOWED_KINDS=1,30017,30018

# Optional ----------------------------------------------------------------

# Force read-only mode even when a signer is set. Useful for eval / dry runs.
# NOSTR_READ_ONLY=false

# Enable the DM tools (nostr_send_dm, nostr_list_dms, nostr_decrypt_dm).
# Default-off — DMs are the highest-risk write surface.
# NOSTR_DM_TOOLS_ENABLED=false

# Limit DM recipients to a specific allowlist. Hex pubkeys (64 chars). Empty
# = no restriction beyond NOSTR_DM_TOOLS_ENABLED itself.
# NOSTR_DM_ALLOWLIST=bb5058aa4c762326b2c02390063f99ace7a7e4c34955d810fb5f44b8de48f355

# Two-step confirmation for write tools — returns a token; second tool call
# executes. Trades agent autonomy for safety.
# NOSTR_REQUIRE_CONFIRM=false

# Rate limits — rolling 60-second windows. Cheap defense against agent loops.
# NOSTR_MAX_EVENTS_PER_MINUTE=10
# NOSTR_MAX_DMS_PER_MINUTE=5

# Opt-in to decoding nsec strings via nostr_decode. Default false — protects
# against an LLM accidentally surfacing a private key in tool output.
# NOSTR_ALLOW_NSEC_DECODE=false

# Logging.
# NOSTR_LOG_PATH=./nostr-mcp.log
# NOSTR_AUDIT_PATH=./nostr-mcp-audit.log
